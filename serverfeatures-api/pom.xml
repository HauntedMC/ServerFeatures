<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.serverfeatures</groupId>
        <artifactId>serverfeatures-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>serverfeatures-api</artifactId>
    <name>ServerFeatures API</name>
    <properties>
        <coverage.line.minimum>0.80</coverage.line.minimum>
    </properties>
    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <includes>
                        <include>nl/hauntedmc/serverfeatures/api/ApiFailureCode.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/ApiOperationException.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/AsyncContract.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/RuntimeState.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/ServerFeaturesApi.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/ServerFeaturesApiVersion.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/capability/**/*.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/economy/**/*.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/graveyard/**/*.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureCatalog.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureCatalogListener.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureClassification.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureDescriptor.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureFailure.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureId.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureRole.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureSnapshot.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/feature/FeatureState.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/service/CapabilityListener.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/service/CapabilityRef.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/service/CapabilityRegistry.java</include>
                        <include>nl/hauntedmc/serverfeatures/api/service/CapabilityUnavailableException.java</include>
                    </includes>
                    <testIncludes>
                        <testInclude>nl/hauntedmc/serverfeatures/api/FeatureContractsTest.java</testInclude>
                        <testInclude>nl/hauntedmc/serverfeatures/api/IdentityAndServiceContractsTest.java</testInclude>
                        <testInclude>nl/hauntedmc/serverfeatures/api/PublicApiSourceBoundaryTest.java</testInclude>
                        <testInclude>nl/hauntedmc/serverfeatures/api/capability/**/*.java</testInclude>
                        <testInclude>nl/hauntedmc/serverfeatures/api/economy/**/*.java</testInclude>
                        <testInclude>nl/hauntedmc/serverfeatures/api/graveyard/**/*.java</testInclude>
                    </testIncludes>
                </configuration>
            </plugin>
            <plugin>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <Automatic-Module-Name>nl.hauntedmc.serverfeatures.api</Automatic-Module-Name>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
