<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.serverfeatures</groupId>
        <artifactId>serverfeatures-parent</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>serverfeatures-platform-acceptance</artifactId>
    <packaging>pom</packaging>
    <name>ServerFeatures Platform Acceptance Fixtures</name>
    <modules>
        <module>consumer</module>
        <!-- Must remain last: it boots artifacts packaged by every preceding reactor module. -->
        <module>runtime</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <artifactId>maven-deploy-plugin</artifactId>
                <configuration><skip>true</skip></configuration>
            </plugin>
        </plugins>
    </build>
</project>
