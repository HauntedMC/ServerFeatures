<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>nl.hauntedmc.serverfeatures</groupId>
        <artifactId>serverfeatures-platform-acceptance</artifactId>
        <version>${revision}</version>
    </parent>
    <artifactId>serverfeatures-platform-acceptance-runtime</artifactId>
    <packaging>pom</packaging>
    <name>ServerFeatures Paper Runtime Acceptance</name>
    <dependencies>
        <!-- Resolve the exact shaded plugins copied into the test Paper instance. -->
        <dependency>
            <groupId>nl.hauntedmc.dataprovider</groupId>
            <artifactId>dataprovider-platform-paper</artifactId>
            <version>${dataprovider.version}</version>
            <classifier>bundled</classifier>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.hauntedmc.dataregistry</groupId>
            <artifactId>dataregistry-platform-paper</artifactId>
            <version>${dataregistry.version}</version>
            <classifier>bundled</classifier>
            <scope>test</scope>
        </dependency>
    </dependencies>
    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>${exec.maven.plugin.version}</version>
                <executions>
                    <execution>
                        <id>boot-paper-platform</id>
                        <phase>verify</phase>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>bash</executable>
                            <arguments>
                                <argument>${project.parent.basedir}/run-platform-acceptance.sh</argument>
                            </arguments>
                            <environmentVariables>
                                <MAVEN_REPO_LOCAL>${settings.localRepository}</MAVEN_REPO_LOCAL>
                            </environmentVariables>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
